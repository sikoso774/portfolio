---
import { Image } from "astro:assets";
import profilePhoto from "../images/photo_profile.jpg";
import { getLocale, localePath, useT } from "../i18n";

// showPhoto : portrait à côté du texte (page /about/ uniquement — l'accueil l'a déjà dans le Hero).
const { showLink = false, showPhoto = false } = Astro.props;
const lang = getLocale(Astro.currentLocale);
const t = useT(lang);
---

<style>
  .about-footer {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  .see-more-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--clr-text-dim);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    padding: 10px 20px;
    border: 1px solid rgba(var(--clr-accent-rgb), 0.2);
    border-radius: var(--radius-sm);
    transition: var(--transition-fast);
  }

  .see-more-link:hover {
    color: var(--clr-accent);
    border-color: rgba(var(--clr-accent-rgb), 0.5);
    background: rgba(var(--clr-accent-rgb), 0.05);
  }

  /* Sur /about/, la section suit directement l'en-tête de page : pas de grand vide entre les deux. */
  .about.on-page {
    padding: 24px 0 48px;
  }

  .about-card.with-photo {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 40px;
    align-items: center;
  }

  .about-photo {
    margin: 0;
    width: 240px;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid rgba(var(--clr-accent-rgb), 0.5);
    box-shadow: 0 0 0 8px rgba(var(--clr-accent-rgb), 0.08);
  }

  /* :global() car <Image> est un composant Astro — son <img> n'hérite pas du cid */
  .about-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .about-card.with-photo {
      grid-template-columns: 1fr;
      gap: 28px;
      justify-items: center;
    }

    .about-photo {
      width: 180px;
    }
  }

  .card p {
    font-size: 18px;
    color: var(--clr-text-muted);
    line-height: 1.8;
    margin-bottom: 24px;
  }

  .card p:last-child {
    margin-bottom: 0;
  }

  .quote-box {
    background: linear-gradient(
      to right,
      rgba(var(--clr-accent-rgb), 0.1),
      transparent
    );
    border-left: 4px solid var(--clr-accent);
    padding: 24px;
    border-radius: 0 8px 8px 0;
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .quote-box svg {
    flex-shrink: 0;
    color: var(--clr-accent);
    margin-top: 4px;
  }

  .quote-box p {
    font-size: 20px;
    font-weight: 600;
    color: var(--clr-text);
    font-style: italic;
    margin: 0;
  }
</style>

<section id="about" class:list={["about", { "on-page": showPhoto }]}>
  <div class="container">
    <div class="section-header">
      <h2>{t.about.title}</h2>
      <div class="underline"></div>
    </div>
    <div class:list={["card", "about-card", { "with-photo": showPhoto }]}>
      {
        showPhoto && (
          <figure class="about-photo">
            <Image
              src={profilePhoto}
              alt={t.hero.photoAlt}
              widths={[180, 240, 360, 480]}
              sizes="(max-width: 768px) 180px, 240px"
              loading="eager"
            />
          </figure>
        )
      }
      <div class="about-text">
        <p>
          {t.about.p1Before}<span class="highlight">{t.about.p1Highlight}</span
          >{t.about.p1After}
        </p>
        <div class="quote-box">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
            ></path>
          </svg>
          <p>{t.about.quote}</p>
        </div>
        <p>{t.about.p2}</p>
      </div>
    </div>
    {
      showLink && (
        <div class="about-footer">
          <a href={localePath("/about/", lang)} class="see-more-link">
            {t.about.learnMore}
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        </div>
      )
    }
  </div>
</section>
