---
import { getLocale, localePath, useT } from "../i18n";

// showPhoto : portrait à côté du texte (page /about/ uniquement — l'accueil l'a déjà dans le Hero).
const { showLink = false, showPhoto = false } = Astro.props;
const lang = getLocale(Astro.currentLocale);
const t = useT(lang);
---

<style>
  .about-footer {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  .see-more-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--clr-text-dim);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    padding: 10px 20px;
    border: 1px solid rgba(var(--clr-accent-rgb), 0.2);
    border-radius: var(--radius-sm);
    transition: var(--transition-fast);
  }

  .see-more-link:hover {
    color: var(--clr-accent);
    border-color: rgba(var(--clr-accent-rgb), 0.5);
    background: rgba(var(--clr-accent-rgb), 0.05);
  }

  /* Sur /about/, la section suit directement l'en-tête de page : pas de grand vide entre les deux. */
  .about.on-page {
    padding: 24px 0 48px;
  }

  .about-card.with-photo {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 40px;
    align-items: center;
  }

  .about-photo {
    margin: 0;
    width: 240px;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid rgba(var(--clr-accent-rgb), 0.5);
    box-shadow: 0 0 0 8px rgba(var(--clr-accent-rgb), 0.08);
  }

  .about-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .about-card.with-photo {
      grid-template-columns: 1fr;
      gap: 28px;
      justify-items: center;
    }

    .about-photo {
      width: 180px;
    }
  }

  .about-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 24px;
  }

  .about-info-card {
    padding: 32px;
  }

  .about-info-card h3 {
    font-size: 22px;
    font-weight: 700;
    color: var(--clr-accent);
    margin-bottom: 12px;
  }

  .about-info-card p {
    font-size: 16px;
    margin-bottom: 20px;
  }

  .values-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 0;
  }

  .values-list li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--clr-text-muted);
    font-size: 16px;
    line-height: 1.6;
  }

  .values-list strong {
    color: var(--clr-text);
    font-weight: 600;
  }

  .info-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .info-tag {
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 500;
    background: rgba(var(--clr-accent-rgb), 0.1);
    border: 1px solid rgba(var(--clr-accent-rgb), 0.3);
    color: var(--clr-accent);
    border-radius: var(--radius-lg);
  }

  @media (max-width: 768px) {
    .about-cards {
      grid-template-columns: 1fr;
    }

    .about-info-card {
      padding: 24px;
    }
  }

  .card p {
    font-size: 18px;
    color: var(--clr-text-muted);
    line-height: 1.8;
    margin-bottom: 24px;
  }

  .card p:last-child {
    margin-bottom: 0;
  }

  .quote-box {
    background: linear-gradient(
      to right,
      rgba(var(--clr-accent-rgb), 0.1),
      transparent
    );
    border-left: 4px solid var(--clr-accent);
    padding: 24px;
    border-radius: 0 8px 8px 0;
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .quote-box svg {
    flex-shrink: 0;
    color: var(--clr-accent);
    margin-top: 4px;
  }

  .quote-box p {
    font-size: 20px;
    font-weight: 600;
    color: var(--clr-text);
    font-style: italic;
    margin: 0;
  }
</style>

<section id="about" class:list={["about", { "on-page": showPhoto }]}>
  <div class="container">
    {
      !showPhoto && (
        <div class="section-header">
          <h2>{t.about.title}</h2>
          <div class="underline" />
        </div>
      )
    }
    <div class:list={["card", "about-card", { "with-photo": showPhoto }]}>
      {
        showPhoto && (
          <figure class="about-photo">
            <img
              src="/assets/images/photo_profile.png"
              alt={t.hero.photoAlt}
              width="999"
              height="1001"
              loading="eager"
              decoding="async"
            />
          </figure>
        )
      }
      <div class="about-text">
        {
          showPhoto ? (
            t.about.page.intro.map((paragraph) => <p>{paragraph}</p>)
          ) : (
            <>
              <p>
                {t.about.p1Before}
                <span class="highlight">{t.about.p1Highlight}</span>
                {t.about.p1After}
              </p>
              <div class="quote-box">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
                <p>{t.about.quote}</p>
              </div>
              <p>{t.about.p2}</p>
            </>
          )
        }
      </div>
    </div>
    {
      showPhoto && (
        <div class="about-cards">
          {t.about.page.cards.map((card) => (
            <div class="card about-info-card">
              <h3>{card.title}</h3>
              <p>{card.text}</p>
              <div class="info-tags">
                {card.tags.map((tag) => (
                  <span class="info-tag">{tag}</span>
                ))}
              </div>
            </div>
          ))}
          <div class="card about-info-card">
            <h3>{t.about.page.valuesTitle}</h3>
            <ul class="values-list">
              {t.about.page.values.map((value) => (
                <li>
                  <strong>{value.name}</strong>
                  <span>{value.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }
    {
      showLink && (
        <div class="about-footer">
          <a href={localePath("/about/", lang)} class="see-more-link">
            {t.about.learnMore}
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        </div>
      )
    }
  </div>
</section>
