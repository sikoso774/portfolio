---
import Icon from "./Icon.astro";
import { getLocale, useT } from "../i18n";
const t = useT(getLocale(Astro.currentLocale));
---

<style>
  .projects {
    background: rgba(0, 0, 0, 0.3);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .project-card {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .project-card h3 {
    font-size: 24px;
    font-weight: 600;
    color: var(--clr-text);
    transition: color 0.2s ease;
  }

  .project-card:hover h3 {
    color: var(--clr-accent);
  }

  .project-card > p {
    color: var(--clr-text-muted);
    line-height: 1.6;
    flex-grow: 1;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-color-scheme: light) {
    .projects {
      background: rgba(0, 0, 0, 0.03);
    }
  }
</style>

<section id="projects" class="projects">
  <div class="container">
    <div class="section-header">
      <h2>{t.projects.title}</h2>
      <div class="underline"></div>
      <p class="section-description">
        {t.projects.intro}
      </p>
    </div>
    <div class="projects-grid">
      <div class="card project-card">
        <h3>{t.projects.items.nebulux.title}</h3>
        <p>
          {t.projects.items.nebulux.description}
        </p>
        <div class="tags">
          <span>CSS</span>
          <span>Obsidian</span>
          <span>{t.projects.items.nebulux.uiDesign}</span>
          <span>{t.projects.items.nebulux.openSource}</span>
        </div>
        <div class="project-links">
          <a href="obsidian://show-theme?name=Nebulux" class="btn-primary">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              ><path
                d="M19.355 18.538a68.967 68.959 0 0 0 1.858-2.954.81.81 0 0 0-.062-.9c-.516-.685-1.504-2.075-2.042-3.362-.553-1.321-.636-3.375-.64-4.377a1.707 1.707 0 0 0-.358-1.05l-3.198-4.064a3.744 3.744 0 0 1-.076.543c-.106.503-.307 1.004-.536 1.5-.134.29-.29.6-.446.914l-.31.626c-.516 1.068-.997 2.227-1.132 3.59-.124 1.26.046 2.73.815 4.481.128.011.257.025.386.044a6.363 6.363 0 0 1 3.326 1.505c.916.79 1.744 1.922 2.415 3.5zM8.199 22.569c.073.012.146.02.22.02.78.024 2.095.092 3.16.29.87.16 2.593.64 4.01 1.055 1.083.316 2.198-.548 2.355-1.664.114-.814.33-1.735.725-2.58l-.01.005c-.67-1.87-1.522-3.078-2.416-3.849a5.295 5.295 0 0 0-2.778-1.257c-1.54-.216-2.952.19-3.84.45.532 2.218.368 4.829-1.425 7.531zM5.533 9.938c-.023.1-.056.197-.098.29L2.82 16.059a1.602 1.602 0 0 0 .313 1.772l4.116 4.24c2.103-3.101 1.796-6.02.836-8.3-.728-1.73-1.832-3.081-2.55-3.831zM9.32 14.01c.615-.183 1.606-.465 2.745-.534-.683-1.725-.848-3.233-.716-4.577.154-1.552.7-2.847 1.235-3.95.113-.235.223-.454.328-.664.149-.297.288-.577.419-.86.217-.47.379-.885.46-1.27.08-.38.08-.72-.014-1.043-.095-.325-.297-.675-.68-1.06a1.6 1.6 0 0 0-1.475.36l-4.95 4.452a1.602 1.602 0 0 0-.513.952l-.427 2.83c.672.59 2.328 2.316 3.335 4.711.09.21.175.43.253.653z"
              ></path></svg
            >

            {t.projects.getOnObsidian}
          </a>
          <a
            href="https://github.com/Sikoso774/Nebulux"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline"
          >
            <Icon name="github-outline" size={16} />
            {t.common.viewCode}
          </a>
        </div>
      </div>

      <div class="card project-card">
        <h3>{t.projects.items.music.title}</h3>
        <p>
          {t.projects.items.music.description}
        </p>
        <div class="tags">
          <span>Python</span>
          <span>Tkinter</span>
          <span>GUI</span>
        </div>
        <a
          href="https://github.com/Sikoso774/Music_Player"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline"
        >
          <Icon name="github-outline" size={16} />
          {t.common.viewCode}
        </a>
      </div>

      <div class="card project-card">
        <h3>{t.projects.items.hypnotica.title}</h3>
        <p>
          {t.projects.items.hypnotica.description}
        </p>
        <div class="tags">
          <span>Python</span>
          <span
            ><a
              href="https://pyga.me/docs"
              target="_blank"
              rel="noopener noreferrer">Pygame</a
            ></span
          >
          <span>{t.projects.items.hypnotica.webDevelopment}</span>
        </div>
        <a
          href="https://github.com/Sikoso774/HYPNOTICA_V4"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline"
        >
          <Icon name="github-outline" size={16} />
          {t.common.viewCode}
        </a>
      </div>

      <div class="card project-card">
        <h3>{t.projects.items.portfolio.title}</h3>
        <p>
          {t.projects.items.portfolio.description}
        </p>
        <div class="tags">
          <span>HTML/CSS</span>
          <span>JavaScript</span>
          <span>GitHub Pages</span>
          <span>{t.projects.items.portfolio.webDeployment}</span>
        </div>
      </div>

      <div class="card project-card">
        <h3>{t.projects.items.scratch.title}</h3>
        <p>
          {t.projects.items.scratch.description}
        </p>
        <div class="tags">
          <span>{t.projects.items.scratch.education}</span>
          <span>Scratch</span>
          <span>{t.projects.items.scratch.teaching}</span>
          <span>{t.projects.items.scratch.curriculumDesign}</span>
        </div>
      </div>

      <div class="card project-card">
        <h3>{t.projects.items.data.title}</h3>
        <p>
          {t.projects.items.data.description}
        </p>
        <div class="tags">
          <span>Python</span>
          <span>Pandas</span>
          <span>Numpy</span>
          <span>Matplotlib</span>
          <span>{t.projects.items.data.dataAnalysis}</span>
        </div>
        <a
          href="https://github.com/Sikoso774/Python"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline"
        >
          <Icon name="github-outline" size={16} />
          {t.common.viewCode}
        </a>
      </div>
    </div>
  </div>
</section>
