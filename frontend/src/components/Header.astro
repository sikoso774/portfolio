---
import Icon from "./Icon.astro";
import {
  alternatePath,
  getLocale,
  htmlLang,
  localeLabel,
  localePath,
  locales,
  useT,
  type Locale,
} from "../i18n";

interface Props {
  // Chemins de la page courante dans chaque langue (par défaut : toutes).
  alternates?: Partial<Record<Locale, string>>;
}

const lang = getLocale(Astro.currentLocale);
const t = useT(lang);
const {
  alternates = Object.fromEntries(
    locales.map((l) => [l, alternatePath(Astro.url.pathname, l)]),
  ) as Partial<Record<Locale, string>>,
} = Astro.props;
// Sélecteur affiché seulement si la page existe dans au moins une autre langue.
const switchable = locales.filter((l) => alternates[l]);
---

<style>
  #header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    transition: var(--transition);
  }

  #header.scrolled {
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
  }

  #header.menu-open {
    background: #030712;
    backdrop-filter: none;
    box-shadow: none;
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    position: relative;
    z-index: 2;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--clr-text);
    flex-shrink: 0;
  }

  .logo-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--grad-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 18px;
    flex-shrink: 0;
  }

  .logo-text {
    font-weight: 600;
    font-size: 18px;
    white-space: nowrap;
  }

  .desktop-nav {
    display: flex;
    gap: 24px;
  }

  .desktop-nav a {
    color: var(--clr-text-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .desktop-nav a:hover {
    color: var(--clr-accent);
  }

  /* Le français est plus long que l'anglais : rien ne doit passer à la ligne,
     sinon les boutons s'étirent sur deux lignes et le sélecteur de langue se déforme. */
  .header-buttons {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header-buttons a {
    white-space: nowrap;
  }

  /* Bouton GitHub : icône seule sur desktop (le libellé reste lu par les lecteurs d'écran). */
  .header-buttons .btn-ghost {
    padding: 10px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .mobile-menu {
    display: none;
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    flex-shrink: 0;
    z-index: 100;
  }

  .mobile-menu-btn span {
    width: 24px;
    height: 2px;
    background: var(--clr-text);
    transition: var(--transition);
    flex-shrink: 0;
  }

  .mobile-menu-btn.active span:nth-child(1) {
    transform: rotate(45deg) translate(8px, 8px);
  }

  .mobile-menu-btn.active span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-btn.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  .nav-num {
    font-size: 11px;
    font-weight: 600;
    color: var(--clr-accent);
    letter-spacing: 0.1em;
    flex-shrink: 0;
    align-self: flex-end;
    padding-bottom: 5px;
  }

  /* Desktop étroit : logo réduit, nav resserrée, GitHub masqué */
  @media (min-width: 901px) and (max-width: 1240px) {
    .logo-text {
      display: none;
    }

    .desktop-nav {
      gap: 16px;
    }

    .desktop-nav a {
      font-size: 13px;
    }

    .header-buttons .btn-ghost {
      display: none;
    }
  }

  /* Menu burger : en français la nav ne tient plus sous 901 px */
  @media (max-width: 900px) {
    .desktop-nav,
    .header-buttons {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }

    /* Full-screen overlay */
    .mobile-menu {
      display: flex;
      position: fixed;
      inset: 0;
      z-index: 1;
      background: #030712;
      flex-direction: column;
      justify-content: center;
      padding: 80px 40px 48px;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    /* Grid pattern */
    .mobile-menu::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(var(--clr-accent-rgb), 0.05) 1px, transparent 1px),
        linear-gradient(
          90deg,
          rgba(var(--clr-accent-rgb), 0.05) 1px,
          transparent 1px
        );
      background-size: 48px 48px;
      pointer-events: none;
    }

    /* Ambient glow bottom-right */
    .mobile-menu::after {
      content: "";
      position: absolute;
      bottom: -120px;
      right: -120px;
      width: 520px;
      height: 520px;
      background: radial-gradient(
        circle,
        rgba(var(--clr-accent-rgb), 0.12) 0%,
        transparent 65%
      );
      pointer-events: none;
    }

    .mobile-menu.active {
      opacity: 1;
      pointer-events: auto;
    }

    .mobile-menu nav {
      display: flex;
      flex-direction: column;
      position: relative;
      z-index: 1;
    }

    /* Exit: simultaneous, fast */
    .mobile-menu nav a {
      display: flex;
      align-items: baseline;
      gap: 14px;
      color: var(--clr-text);
      text-decoration: none;
      font-size: 38px;
      font-weight: 700;
      line-height: 1;
      padding: 14px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      transform: translateX(-28px);
      opacity: 0;
      transition:
        transform 0.2s ease,
        opacity 0.15s ease,
        color 0.2s ease;
    }

    .mobile-menu nav a:first-child {
      border-top: 1px solid rgba(255, 255, 255, 0.07);
    }

    .mobile-menu nav a:hover {
      color: var(--clr-accent);
    }

    /* Enter: staggered */
    .mobile-menu.active nav a {
      transform: translateX(0);
      opacity: 1;
      transition:
        transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)
          calc(var(--i, 0) * 60ms + 0.05s),
        opacity 0.4s ease calc(var(--i, 0) * 60ms + 0.05s),
        color 0.2s ease;
    }

    .mobile-menu-actions {
      display: flex;
      gap: 12px;
      margin-top: 32px;
      position: relative;
      z-index: 1;
      transform: translateY(14px);
      opacity: 0;
      transition:
        transform 0.2s ease,
        opacity 0.15s ease;
    }

    .mobile-menu.active .mobile-menu-actions {
      transform: translateY(0);
      opacity: 1;
      transition:
        transform 0.45s ease 0.42s,
        opacity 0.4s ease 0.42s;
    }

    .mobile-menu-actions a {
      flex: 1;
      justify-content: center;
    }

    /* Small height (landscape phone) */
    @media (max-height: 600px) {
      .mobile-menu nav a {
        font-size: 26px;
        padding: 9px 0;
      }
      .mobile-menu {
        padding-top: 64px;
      }
    }
  }

  @media (prefers-color-scheme: light) {
    #header.scrolled {
      background: rgba(255, 255, 255, 0.95);
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.08);
    }

    #header.menu-open {
      background: #f8fafc;
      box-shadow: none;
    }

    .logo-circle {
      color: #ffffff;
    }

    .mobile-menu {
      background: #f8fafc;
    }

    .mobile-menu nav a {
      color: #111827;
      border-bottom-color: rgba(0, 0, 0, 0.08);
    }

    .mobile-menu nav a:first-child {
      border-top-color: rgba(0, 0, 0, 0.08);
    }
  }

  .lang-switch {
    display: inline-flex;
    white-space: nowrap;
    gap: 2px;
    padding: 3px;
    border: 1px solid rgba(var(--clr-accent-rgb), 0.3);
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
  }

  .lang-switch a,
  .lang-switch .lang-current {
    padding: 6px 9px;
    border-radius: 6px;
  }

  .lang-switch a {
    text-decoration: none;
    color: var(--clr-text-muted);
    transition: var(--transition-fast);
  }

  .lang-switch a:hover {
    color: var(--clr-accent);
  }

  .lang-switch .lang-current {
    background: rgba(var(--clr-accent-rgb), 0.2);
    color: var(--clr-accent);
  }

  /* Mobile : le sélecteur occupe sa propre ligne, en contrôle segmenté pleine largeur. */
  .mobile-menu-actions {
    flex-wrap: wrap;
  }

  .mobile-menu-actions .lang-switch {
    flex: 0 0 100%;
  }

  .mobile-menu-actions .lang-switch a,
  .mobile-menu-actions .lang-switch .lang-current {
    flex: 1;
    text-align: center;
  }
</style>

<header id="header">
  <div class="container">
    <div class="header-content">
      <a href={localePath("/", lang)} class="logo">
        <div class="logo-circle">ZK</div>
        <span class="logo-text">Zoléni Kokolo</span>
      </a>

      <nav class="desktop-nav">
        <a href={localePath("/about/", lang)}>{t.nav.about}</a>
        <a href={localePath("/skills/", lang)}>{t.nav.skills}</a>
        <a href={localePath("/experience/", lang)}>{t.nav.experience}</a>
        <a href={localePath("/projects/", lang)}>{t.nav.projects}</a>
        <a href={localePath("/blog/", lang)}>{t.nav.blog}</a>
        <a href={localePath("/contact/", lang)}>{t.nav.contact}</a>
      </nav>

      <div class="header-buttons">
        {switchable.length > 1 && (
          <div class="lang-switch" role="group" aria-label={t.nav.language}>
            {switchable.map((l) =>
              l === lang ? (
                <span class="lang-current" aria-current="true">
                  {l.toUpperCase()}
                </span>
              ) : (
                <a
                  href={alternates[l]}
                  hreflang={htmlLang[l]}
                  lang={htmlLang[l]}
                  title={localeLabel[l]}
                  data-astro-reload
                >
                  {l.toUpperCase()}
                </a>
              ),
            )}
          </div>
        )}
        <a
          href="https://github.com/Sikoso774"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
          title={t.nav.github}
        >
          <Icon name="github-outline" size={16} />
          <span class="sr-only">{t.nav.github}</span>
        </a>
        <a
          href="/assets/docs/CV_Zoleni_KOKOLO_ZASSI.pdf"
          download
          class="btn-primary"
        >
          <Icon name="download" size={16} />
          {t.nav.downloadCv}
        </a>
      </div>

      <button
        class="mobile-menu-btn"
        id="mobileMenuBtn"
        aria-label={t.nav.toggleMenu}
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
      <nav>
        <a href={localePath("/about/", lang)} style="--i:0">
          <span class="nav-num">01</span>
          {t.nav.about}
        </a>
        <a href={localePath("/skills/", lang)} style="--i:1">
          <span class="nav-num">02</span>
          {t.nav.skills}
        </a>
        <a href={localePath("/experience/", lang)} style="--i:2">
          <span class="nav-num">03</span>
          {t.nav.experience}
        </a>
        <a href={localePath("/projects/", lang)} style="--i:3">
          <span class="nav-num">04</span>
          {t.nav.projects}
        </a>
        <a href={localePath("/blog/", lang)} style="--i:4">
          <span class="nav-num">05</span>
          {t.nav.blog}
        </a>
        <a href={localePath("/contact/", lang)} style="--i:5">
          <span class="nav-num">06</span>
          {t.nav.contact}
        </a>
      </nav>
      <div class="mobile-menu-actions">
        {switchable.length > 1 && (
          <div class="lang-switch" role="group" aria-label={t.nav.language}>
            {switchable.map((l) =>
              l === lang ? (
                <span class="lang-current" aria-current="true">
                  {l.toUpperCase()}
                </span>
              ) : (
                <a
                  href={alternates[l]}
                  hreflang={htmlLang[l]}
                  lang={htmlLang[l]}
                  title={localeLabel[l]}
                  data-astro-reload
                >
                  {l.toUpperCase()}
                </a>
              ),
            )}
          </div>
        )}
        <a
          href="https://github.com/Sikoso774"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          <Icon name="github-outline" size={16} />
          {t.nav.github}
        </a>
        <a
          href="/assets/docs/CV_Zoleni_KOKOLO_ZASSI.pdf"
          download
          class="btn-outline"
        >
          <Icon name="download" size={16} />
          {t.nav.downloadCv}
        </a>
      </div>
    </div>
  </div>
</header>
