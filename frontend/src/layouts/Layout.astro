---
import "@fontsource-variable/inter";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import {
  alternatePath,
  defaultLocale,
  getLocale,
  htmlLang,
  localePath,
  locales,
  ogLocale,
  useT,
  type Locale,
} from "../i18n";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article" | "profile";
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  // Entités schema.org supplémentaires (ProfilePage, BlogPosting…) ajoutées au @graph.
  schema?: Record<string, unknown>[];
  // Chemins de cette page dans chaque langue où elle existe (hreflang). Par défaut :
  // même chemin dans toutes les langues. Un article sans traduction passe sa seule langue.
  alternates?: Partial<Record<Locale, string>>;
}

const lang = getLocale(Astro.currentLocale);
const t = useT(lang);

const {
  title = t.meta.home.title,
  description = t.meta.home.description,
  ogType = "website",
  noindex = false,
  publishedTime,
  modifiedTime,
  schema = [],
  alternates = Object.fromEntries(
    locales.map((l) => [l, alternatePath(Astro.url.pathname, l)]),
  ) as Partial<Record<Locale, string>>,
} = Astro.props;

// hreflang : une entrée par langue disponible + x-default (anglais). Inutile pour
// une page 404 ou une page qui n'existe que dans une langue.
const alternateEntries = (Object.entries(alternates) as [Locale, string][]).map(
  ([l, path]) => ({ locale: l, url: new URL(path, Astro.site) }),
);
const showHreflang = !noindex && alternateEntries.length > 1;
const defaultAlternate = alternateEntries.find(
  (a) => a.locale === defaultLocale,
);
const otherLocales = alternateEntries.filter((a) => a.locale !== lang);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Bannière dédiée 1200×630 pour le partage social (généré via scripts/generate-og.mjs).
const ogImage = new URL("/assets/images/og-image.png", Astro.site);
// Photo réelle pour le schema.org Person (Google préfère un portrait, pas la bannière).
const personImage = new URL("/assets/images/photo_profile.png", Astro.site);

const siteURL = Astro.site?.toString() ?? "https://zolenikokolo.com/";
// Identifiants stables : les autres entités (BlogPosting, ProfilePage…) y renvoient.
const personId = `${siteURL}#person`;
const websiteId = `${siteURL}#website`;

const personSchema = {
  "@type": "Person",
  "@id": personId,
  name: "Zoléni Kokolo Zassi",
  alternateName: ["Zoléni KOKOLO ZASSI", "Zoleni Kokolo Zassi"],
  url: siteURL,
  image: personImage.toString(),
  jobTitle: t.person.jobTitle,
  description: t.person.description,
  knowsLanguage: ["fr", "en", "es"],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "ENSEA Cergy",
  },
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "Université Paris 1 Panthéon-Sorbonne",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Chauconin-Neufmontiers",
    addressCountry: "FR",
  },
  sameAs: [
    "https://github.com/Sikoso774",
    "https://www.linkedin.com/in/zoléni-kokolo-zassi-280a282ba",
  ],
  knowsAbout: [
    "Python",
    "Data Science",
    "Linux",
    "Docker",
    "LXC",
    "Web Development",
    "Automation",
  ],
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": websiteId,
  url: siteURL,
  name: "Zoléni Kokolo Zassi",
  inLanguage: locales.map((l) => htmlLang[l]),
  publisher: { "@id": personId },
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [personSchema, websiteSchema, ...schema],
};
---

<!doctype html>
<!--
  © 2026 Zoléni Kokolo Zassi — All Rights Reserved.
  Design, content and source code are the exclusive property of Zoléni Kokolo Zassi.
  This site is shared for portfolio purposes only. Copying or reusing any part
  without prior written authorization is strictly prohibited.
  Contact: https://zolenikokolo.com/contact
-->
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta name="author" content="Zoléni Kokolo Zassi" />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow"}
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t.blog.rssTitle}
      href={localePath("/rss.xml", lang)}
    />
    {
      showHreflang && (
        <>
          {alternateEntries.map((a) => (
            <link rel="alternate" hreflang={htmlLang[a.locale]} href={a.url} />
          ))}
          {defaultAlternate && (
            <link
              rel="alternate"
              hreflang="x-default"
              href={defaultAlternate.url}
            />
          )}
        </>
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Zoléni Kokolo Zassi" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {
      showHreflang &&
        otherLocales.map((a) => (
          <meta property="og:locale:alternate" content={ogLocale[a.locale]} />
        ))
    }
    {
      ogType === "article" && (
        <>
          {publishedTime && (
            <meta
              property="article:published_time"
              content={publishedTime.toISOString()}
            />
          )}
          {modifiedTime && (
            <meta
              property="article:modified_time"
              content={modifiedTime.toISOString()}
            />
          )}
          <meta property="article:author" content={siteURL} />
        </>
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <ClientRouter />
  </head>
  <body>
    <div id="scroll-progress"></div>
    <slot />
    <button id="back-to-top" aria-label={t.common.backToTop}>
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>
    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
