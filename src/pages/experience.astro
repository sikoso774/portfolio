---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Experience & Education — Zoléni Kokolo Zassi"
  description="Professional experience and academic background of Zoléni Kokolo Zassi — Python developer, infrastructure engineer, and ENSEA student."
>
  <Header />
  <main>

    <section class="page-hero">
      <div class="container">
        <div class="section-header">
          <h1>Experience & Education</h1>
          <div class="underline"></div>
          <p class="section-description">
            My professional journey and academic background, from internships to university.
          </p>
        </div>
      </div>
    </section>

    <section class="xp-section">
      <div class="container">

        <div class="block-header">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
          <h2>Work Experience</h2>
        </div>

        <div class="timeline">

          <div class="timeline-item card">
            <div class="timeline-dot"></div>
            <div class="timeline-date">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              Apr 2026 – Present
            </div>
            <h3>Python Developer</h3>
            <p class="company">NOXIA Security &nbsp;·&nbsp; Bailly Romainvilliers</p>
            <p class="description">
              Development of in-house tools for the company to streamline internal security workflows and automate repetitive operational tasks.
            </p>
            <div class="tech-tags">
              <span class="tag">Python</span>
              <span class="tag">Automation</span>
              <span class="tag">Security</span>
            </div>
          </div>

          <div class="timeline-item card">
            <div class="timeline-dot"></div>
            <div class="timeline-date">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              Nov 2025 – Jan 2026
            </div>
            <h3>Infrastructure & Backend Python Engineer Intern</h3>
            <p class="company">Maison Astéria &nbsp;·&nbsp; Bazainville</p>
            <p class="description">
              Migration of a bot farming infrastructure from Docker to LXC/Waydroid. Wrote Python and Bash orchestration scripts to automate container lifecycle management and deployed the entire stack on a Linux server.
            </p>
            <div class="tech-tags">
              <span class="tag">Python</span>
              <span class="tag">Bash</span>
              <span class="tag">LXC</span>
              <span class="tag">Waydroid</span>
              <span class="tag">Docker</span>
              <span class="tag">Linux</span>
            </div>
          </div>

          <div class="timeline-item card">
            <div class="timeline-dot"></div>
            <div class="timeline-date">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              May 2025 – Jun 2025
            </div>
            <h3>Full Stack Developer & Automation Intern</h3>
            <p class="company">Rhôn Telecom &nbsp;·&nbsp; Champs-sur-Marne</p>
            <p class="description">
              Developed automation tools with VBA and Node.js to improve internal productivity. Built a Next.js interface to streamline network operations and reduce manual data entry across departments.
            </p>
            <div class="tech-tags">
              <span class="tag">Node.js</span>
              <span class="tag">Next.js</span>
              <span class="tag">VBA</span>
              <span class="tag">Automation</span>
            </div>
          </div>

          <div class="timeline-item card">
            <div class="timeline-dot"></div>
            <div class="timeline-date">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              2024
            </div>
            <h3>Scratch Programming Workshop for Children</h3>
            <p class="company">Teaching Internship &nbsp;·&nbsp; Cergy</p>
            <p class="description">
              Designed and led an introductory coding workshop for children. Guided students through their first programming experience using Scratch, fostering creativity and logical thinking through interactive exercises.
            </p>
            <div class="tech-tags">
              <span class="tag">Scratch</span>
              <span class="tag">Teaching</span>
            </div>
          </div>

          <div class="timeline-item card">
            <div class="timeline-dot"></div>
            <div class="timeline-date">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              2020
            </div>
            <h3>Observation Internship</h3>
            <p class="company">Alstom Transport &nbsp;·&nbsp; Le Creusot</p>
            <p class="description">
              Discovered industrial processes and railway production systems, gaining insights into large-scale engineering projects and manufacturing workflows.
            </p>
            <div class="tech-tags">
              <span class="tag">Industrial Engineering</span>
              <span class="tag">Railway Systems</span>
            </div>
          </div>

        </div>

        <div class="block-header" style="margin-top: 80px">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
          <h2>Education</h2>
        </div>

        <div class="education-grid">

          <div class="card education-card">
            <div class="edu-year">2023 – 2026</div>
            <h3>Bachelor Human-IT</h3>
            <p class="company">ENSEA &nbsp;·&nbsp; Cergy</p>
            <p class="description">
              Specializing in information technologies and their societal impact, with a strong focus on data science, software development, and human-computer interaction.
            </p>
            <div class="tech-tags" style="margin-top: 16px;">
              <span class="tag">Data Science</span>
              <span class="tag">Python</span>
              <span class="tag">C</span>
              <span class="tag">SQL</span>
            </div>
          </div>

          <div class="card education-card">
            <div class="edu-year">2023</div>
            <h3>Baccalauréat Général</h3>
            <p class="company">Lycée Bossuet &nbsp;·&nbsp; Meaux</p>
            <p class="description">
              Graduated with a specialization in Mathématiques Expertes. Built a strong foundation in analytical thinking, mathematical reasoning, and problem solving.
            </p>
            <div class="tech-tags" style="margin-top: 16px;">
              <span class="tag">Mathématiques Expertes</span>
            </div>
          </div>

        </div>

      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .page-hero {
    padding: 160px 0 32px;
  }

  .page-hero h1 {
    font-size: 48px;
    font-weight: 700;
  }

  .xp-section {
    padding-top: 0;
  }

  .block-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 36px;
  }

  .block-header svg {
    color: var(--clr-accent);
    flex-shrink: 0;
  }

  .block-header h2 {
    font-size: 26px;
    font-weight: 700;
    color: var(--clr-text);
  }

  /* Timeline */
  .timeline {
    position: relative;
    padding-left: 52px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 12px;
    bottom: 12px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(var(--clr-accent-rgb), 0.35) 8%,
      rgba(var(--clr-accent-rgb), 0.35) 92%,
      transparent
    );
  }

  .timeline-item {
    position: relative;
    padding: 24px 28px;
    margin-bottom: 20px;
  }

  .timeline-dot {
    position: absolute;
    left: -44px;
    top: 30px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--clr-accent);
    border: 3px solid rgba(var(--clr-accent-rgb), 0.2);
    box-shadow: 0 0 0 4px rgba(var(--clr-accent-rgb), 0.08);
    z-index: 1;
  }

  .timeline-date {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--clr-accent);
    margin-bottom: 10px;
  }

  .timeline-item h3 {
    font-size: 18px;
    font-weight: 600;
    color: var(--clr-text);
    margin-bottom: 6px;
    line-height: 1.3;
  }

  .company {
    color: var(--clr-accent);
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 12px;
  }

  .description {
    color: var(--clr-text-muted);
    font-size: 14px;
    line-height: 1.65;
    margin-bottom: 0;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .tag {
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 500;
    background: rgba(var(--clr-accent-rgb), 0.1);
    border: 1px solid rgba(var(--clr-accent-rgb), 0.3);
    color: var(--clr-accent);
    border-radius: var(--radius-lg);
  }

  /* Education grid */
  .education-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .education-card {
    padding: 28px;
  }

  .edu-year {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    color: var(--clr-accent);
    background: rgba(var(--clr-accent-rgb), 0.1);
    border: 1px solid rgba(var(--clr-accent-rgb), 0.2);
    border-radius: 24px;
    padding: 3px 12px;
    margin-bottom: 16px;
  }

  .education-card h3 {
    font-size: 20px;
    font-weight: 600;
    color: var(--clr-text);
    margin-bottom: 6px;
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: 120px 0 24px;
    }

    .page-hero h1 {
      font-size: 32px;
    }

    .timeline {
      padding-left: 32px;
    }

    .timeline::before {
      left: 8px;
    }

    .timeline-dot {
      left: -28px;
      top: 24px;
    }

    .timeline-item {
      padding: 20px;
    }

    .education-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
