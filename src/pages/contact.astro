---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { EMAIL_USER, EMAIL_DOMAIN } from "../site.js";
---

<Layout
  title="Contact — Zoléni Kokolo Zassi"
  description="Get in touch with Zoléni Kokolo Zassi — open to opportunities, collaborations, and conversations."
>
  <Header />
  <main>
    <section class="page-hero">
      <div class="container">
        <div class="section-header">
          <h1>Let's Connect</h1>
          <div class="underline"></div>
          <p class="section-description">
            Open to new opportunities, collaborations, or just a good tech
            conversation.
          </p>
        </div>
      </div>
    </section>

    <section class="contact-section">
      <div class="container">
        <div class="contact-grid">
          <!-- Info column -->
          <div class="contact-info">
            <div class="info-card card">
              <div class="status-badge">
                <span class="status-dot"></span>
                Available for opportunities
              </div>

              <div class="info-items">
                <div class="info-item">
                  <div class="info-icon">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                      ></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                  </div>
                  <div>
                    <p class="info-label">Location</p>
                    <p class="info-value">Chauconin-Neufmontiers, France</p>
                  </div>
                </div>

                <div class="info-item">
                  <div class="info-icon">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                      ></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                  </div>
                  <div>
                    <p class="info-label">Email</p>
                    <a id="contact-email" href="#" class="info-value info-link"
                      >—</a
                    >
                  </div>
                </div>

                <div class="info-item">
                  <div class="info-icon">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"
                      ></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                  </div>
                  <div>
                    <p class="info-label">Response time</p>
                    <p class="info-value">Usually within 48h</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="social-card card">
              <p class="social-label">Find me on</p>
              <div class="social-links">
                <a
                  href="https://github.com/Sikoso774"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="social-link"
                >
                  <Icon name="github" size={20} />
                  <span>GitHub</span>
                  <Icon name="external-link" size={12} class="external-icon" />
                </a>
                <a
                  href="https://www.linkedin.com/in/zoléni-kokolo-zassi-280a282ba"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="social-link"
                >
                  <Icon name="linkedin" size={20} />
                  <span>LinkedIn</span>
                  <Icon name="external-link" size={12} class="external-icon" />
                </a>
              </div>
            </div>
          </div>

          <!-- Form column -->
          <div class="form-wrapper card">
            <h2>Send a message</h2>
            <p class="form-subtitle">
              Fill in the form and your email client will open with the message
              ready to send.
            </p>

            <form id="contact-form">
              <div class="form-row">
                <div class="form-group">
                  <label for="name">Full name</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Your name"
                    required
                    autocomplete="name"
                  />
                </div>
                <div class="form-group">
                  <label for="email">Email address</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="you@example.com"
                    required
                    autocomplete="email"
                  />
                </div>
              </div>

              <div class="form-group">
                <label for="subject">Subject</label>
                <input
                  type="text"
                  id="subject"
                  name="subject"
                  placeholder="What's it about?"
                  required
                />
              </div>

              <div class="form-group">
                <label for="message">Message</label>
                <textarea
                  id="message"
                  name="message"
                  rows="6"
                  placeholder="Tell me more..."
                  required></textarea>
              </div>

              <button type="submit" class="btn-primary submit-btn">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
                Send message
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script is:inline define:vars={{ u: EMAIL_USER, d: EMAIL_DOMAIN }}>
  // Email obfuscation
  const email = u + "@" + d;

  const emailLink = document.getElementById("contact-email");
  if (emailLink) {
    emailLink.textContent = email;
    emailLink.href = "mailto:" + email;
  }

  const form = document.getElementById("contact-form");

  // La validation (champs requis, format email) est native : le submit ne
  // se déclenche que si le formulaire est valide.
  form.addEventListener("submit", function (e) {
    e.preventDefault();

    const data = new FormData(form);
    const name = data.get("name").trim();
    const senderEmail = data.get("email").trim();
    const subject = data.get("subject").trim();
    const message = data.get("message").trim();

    const body = "Name: " + name + "\nEmail: " + senderEmail + "\n\n" + message;
    window.location.href =
      "mailto:" +
      email +
      "?subject=" +
      encodeURIComponent(subject) +
      "&body=" +
      encodeURIComponent(body);
  });
</script>

<style>
  .page-hero {
    padding: 160px 0 32px;
  }

  .page-hero h1 {
    font-size: 48px;
    font-weight: 700;
  }

  .contact-section {
    padding-top: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 32px;
    align-items: start;
  }

  /* Info column */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .info-card {
    padding: 28px;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(var(--clr-accent-rgb), 0.1);
    border: 1px solid rgba(var(--clr-accent-rgb), 0.3);
    border-radius: 24px;
    color: var(--clr-accent);
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 24px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--clr-accent);
    animation: pulse-dot 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.7);
    }
  }

  .info-items {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .info-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: rgba(var(--clr-accent-rgb), 0.1);
    border: 1px solid rgba(var(--clr-accent-rgb), 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--clr-accent);
    flex-shrink: 0;
  }

  .info-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--clr-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 2px;
  }

  .info-value {
    font-size: 14px;
    color: var(--clr-text-muted);
  }

  .info-link {
    color: var(--clr-accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .info-link:hover {
    color: var(--clr-text);
    text-decoration: underline;
  }

  .social-card {
    padding: 24px 28px;
  }

  .social-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--clr-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 14px;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(var(--clr-accent-rgb), 0.15);
    border-radius: var(--radius-sm);
    color: var(--clr-text-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: var(--transition-fast);
  }

  .social-link:hover {
    border-color: rgba(var(--clr-accent-rgb), 0.4);
    color: var(--clr-accent);
    background: rgba(var(--clr-accent-rgb), 0.06);
  }

  .social-link span {
    flex: 1;
  }

  /* :global() requis : le svg est rendu par le composant enfant Icon.astro,
     il ne porte donc pas l'attribut de scoping de cette page. */
  .social-link :global(.external-icon) {
    opacity: 0.4;
    transition: opacity 0.2s ease;
  }

  .social-link:hover :global(.external-icon) {
    opacity: 0.8;
  }

  /* Form column */
  .form-wrapper {
    padding: 36px;
  }

  .form-wrapper h2 {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .form-subtitle {
    font-size: 13px;
    color: var(--clr-text-dim);
    margin-bottom: 28px;
    line-height: 1.5;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 13px;
    font-weight: 500;
    color: var(--clr-text-muted);
  }

  .form-group input,
  .form-group textarea {
    padding: 12px 16px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(var(--clr-accent-rgb), 0.2);
    border-radius: var(--radius-sm);
    color: var(--clr-text);
    font-family: var(--font-base);
    font-size: 14px;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
    outline: none;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--clr-text-dim);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: rgba(var(--clr-accent-rgb), 0.55);
    box-shadow: 0 0 0 3px rgba(var(--clr-accent-rgb), 0.08);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 140px;
    line-height: 1.6;
  }

  .submit-btn {
    align-self: flex-start;
    padding: 12px 28px;
    font-size: 15px;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-info {
      order: 1;
    }

    .form-wrapper {
      order: 0;
    }
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: 120px 0 24px;
    }

    .page-hero h1 {
      font-size: 32px;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .form-wrapper {
      padding: 24px;
    }
  }
</style>
