---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact — Zoléni Kokolo Zassi"
  description="Get in touch with Zoléni Kokolo Zassi — open to opportunities, collaborations, and conversations."
>
  <Header />
  <main>

    <section class="page-hero">
      <div class="container">
        <div class="section-header">
          <h1>Let's Connect</h1>
          <div class="underline"></div>
          <p class="section-description">
            Open to new opportunities, collaborations, or just a good tech conversation.
          </p>
        </div>
      </div>
    </section>

    <section class="contact-section">
      <div class="container">
        <div class="contact-grid">

          <!-- Info column -->
          <div class="contact-info">

            <div class="info-card card">
              <div class="status-badge">
                <span class="status-dot"></span>
                Available for opportunities
              </div>

              <div class="info-items">
                <div class="info-item">
                  <div class="info-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                  </div>
                  <div>
                    <p class="info-label">Location</p>
                    <p class="info-value">Chauconin-Neufmontiers, France</p>
                  </div>
                </div>

                <div class="info-item">
                  <div class="info-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                  </div>
                  <div>
                    <p class="info-label">Email</p>
                    <a id="contact-email" href="#" class="info-value info-link">—</a>
                  </div>
                </div>

                <div class="info-item">
                  <div class="info-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                  </div>
                  <div>
                    <p class="info-label">Response time</p>
                    <p class="info-value">Usually within 48h</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="social-card card">
              <p class="social-label">Find me on</p>
              <div class="social-links">
                <a href="https://github.com/Sikoso774" target="_blank" rel="noopener noreferrer" class="social-link">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                    <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                  </svg>
                  <span>GitHub</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="external-icon">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
                <a href="https://www.linkedin.com/in/zoléni-kokolo-zassi-280a282ba" target="_blank" rel="noopener noreferrer" class="social-link">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.14-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
                  </svg>
                  <span>LinkedIn</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="external-icon">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              </div>
            </div>

          </div>

          <!-- Form column -->
          <div class="form-wrapper card">
            <h2>Send a message</h2>
            <p class="form-subtitle">Fill in the form and your email client will open with the message ready to send.</p>

            <form id="contact-form" novalidate>
              <div class="form-row">
                <div class="form-group">
                  <label for="name">Full name</label>
                  <input type="text" id="name" name="name" placeholder="Your name" required autocomplete="name" />
                </div>
                <div class="form-group">
                  <label for="email">Email address</label>
                  <input type="email" id="email" name="email" placeholder="you@example.com" required autocomplete="email" />
                </div>
              </div>

              <div class="form-group">
                <label for="subject">Subject</label>
                <input type="text" id="subject" name="subject" placeholder="What's it about?" required />
              </div>

              <div class="form-group">
                <label for="message">Message</label>
                <textarea id="message" name="message" rows="6" placeholder="Tell me more..." required></textarea>
              </div>

              <div id="form-error" class="form-error" hidden>Please fill in all fields before sending.</div>

              <button type="submit" class="btn-primary submit-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
                Send message
              </button>
            </form>
          </div>

        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<script is:inline>
  // Email obfuscation
  const u = 'zolenikokolozassi';
  const d = 'gmail.com';
  const email = u + '@' + d;

  const emailLink = document.getElementById('contact-email');
  if (emailLink) {
    emailLink.textContent = email;
    emailLink.href = 'mailto:' + email;
  }

  const form = document.getElementById('contact-form');
  const formError = document.getElementById('form-error');

  form.addEventListener('submit', function (e) {
    e.preventDefault();

    const name = form.querySelector('#name').value.trim();
    const senderEmail = form.querySelector('#email').value.trim();
    const subject = form.querySelector('#subject').value.trim();
    const message = form.querySelector('#message').value.trim();

    if (!name || !senderEmail || !subject || !message) {
      formError.hidden = false;
      return;
    }

    formError.hidden = true;

    const body = 'Name: ' + name + '\nEmail: ' + senderEmail + '\n\n' + message;
    window.location.href =
      'mailto:' + email +
      '?subject=' + encodeURIComponent(subject) +
      '&body=' + encodeURIComponent(body);
  });
</script>

<style>
  .page-hero {
    padding: 160px 0 32px;
  }

  .page-hero h1 {
    font-size: 48px;
    font-weight: 700;
  }

  .contact-section {
    padding-top: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 32px;
    align-items: start;
  }

  /* Info column */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .info-card {
    padding: 28px;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(var(--clr-accent-rgb), 0.1);
    border: 1px solid rgba(var(--clr-accent-rgb), 0.3);
    border-radius: 24px;
    color: var(--clr-accent);
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 24px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--clr-accent);
    animation: pulse-dot 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.7); }
  }

  .info-items {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .info-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: rgba(var(--clr-accent-rgb), 0.1);
    border: 1px solid rgba(var(--clr-accent-rgb), 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--clr-accent);
    flex-shrink: 0;
  }

  .info-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--clr-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 2px;
  }

  .info-value {
    font-size: 14px;
    color: var(--clr-text-muted);
  }

  .info-link {
    color: var(--clr-accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .info-link:hover {
    color: var(--clr-text);
    text-decoration: underline;
  }

  .social-card {
    padding: 24px 28px;
  }

  .social-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--clr-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 14px;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(var(--clr-accent-rgb), 0.15);
    border-radius: var(--radius-sm);
    color: var(--clr-text-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: var(--transition-fast);
  }

  .social-link:hover {
    border-color: rgba(var(--clr-accent-rgb), 0.4);
    color: var(--clr-accent);
    background: rgba(var(--clr-accent-rgb), 0.06);
  }

  .social-link span {
    flex: 1;
  }

  .external-icon {
    opacity: 0.4;
    transition: opacity 0.2s ease;
  }

  .social-link:hover .external-icon {
    opacity: 0.8;
  }

  /* Form column */
  .form-wrapper {
    padding: 36px;
  }

  .form-wrapper h2 {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .form-subtitle {
    font-size: 13px;
    color: var(--clr-text-dim);
    margin-bottom: 28px;
    line-height: 1.5;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 13px;
    font-weight: 500;
    color: var(--clr-text-muted);
  }

  .form-group input,
  .form-group textarea {
    padding: 12px 16px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(var(--clr-accent-rgb), 0.2);
    border-radius: var(--radius-sm);
    color: var(--clr-text);
    font-family: var(--font-base);
    font-size: 14px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    outline: none;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--clr-text-dim);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: rgba(var(--clr-accent-rgb), 0.55);
    box-shadow: 0 0 0 3px rgba(var(--clr-accent-rgb), 0.08);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 140px;
    line-height: 1.6;
  }

  .form-error {
    font-size: 13px;
    color: #f87171;
    padding: 10px 14px;
    background: rgba(248, 113, 113, 0.08);
    border: 1px solid rgba(248, 113, 113, 0.2);
    border-radius: var(--radius-sm);
  }

  .submit-btn {
    align-self: flex-start;
    padding: 12px 28px;
    font-size: 15px;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-info {
      order: 1;
    }

    .form-wrapper {
      order: 0;
    }
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: 120px 0 24px;
    }

    .page-hero h1 {
      font-size: 32px;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .form-wrapper {
      padding: 24px;
    }
  }
</style>
