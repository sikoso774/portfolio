---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import About from "../components/About.astro";
import Languages from "../components/Languages.astro";
import { profilePage } from "../utils/schema";

const schema = [
  profilePage(Astro.site!, "/about/", "About Zoléni Kokolo Zassi"),
];
---

<Layout
  title="About Zoléni Kokolo Zassi — Student at ENSEA Cergy"
  description="Who is Zoléni Kokolo Zassi? A Python developer and Bachelor Human IT student at ENSEA Cergy — background, interests and languages."
  ogType="profile"
  schema={schema}
>
  <Header />
  <main>
    <section class="page-hero">
      <div class="container">
        <div class="section-header">
          <h1>About Me</h1>
          <div class="underline"></div>
          <p class="section-description">
            A closer look at who I am, what I care about, and what keeps me
            curious outside of code.
          </p>
        </div>
      </div>
    </section>
    <About />
    <Languages />
  </main>
  <Footer />
</Layout>

<style>
  .page-hero {
    padding: 160px 0 32px;
  }

  .page-hero h1 {
    font-size: 48px;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .page-hero {
      padding: 120px 0 24px;
    }

    .page-hero h1 {
      font-size: 32px;
    }
  }
</style>
