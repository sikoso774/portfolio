---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { blogPosting } from "../../utils/schema";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const articleSchema = blogPosting({
  site: Astro.site!,
  pathname: Astro.url.pathname,
  title: post.data.title,
  description: post.data.description,
  image: new URL("/assets/img/og-image.png", Astro.site),
  tags: post.data.tags,
  pubDate: post.data.pubDate,
  updatedDate: post.data.updatedDate,
});

const dateFmt = new Intl.DateTimeFormat("en-US", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout
  title={`${post.data.title} — Zoléni Kokolo Zassi`}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate ?? post.data.pubDate}
  schema={[articleSchema]}
>
  <Header />
  <main class="blog-page">
    <article class="container article">
      <a href="/blog/" class="article-back">← Back to blog</a>
      <header class="article-header">
        <div class="tags">
          {post.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
        <h1>{post.data.title}</h1>
        <div class="article-meta">
          <span>
            By <a href="/about/" rel="author">Zoléni Kokolo Zassi</a> ·
          </span>
          <time datetime={post.data.pubDate.toISOString()}>
            {dateFmt.format(post.data.pubDate)}
          </time>
          {
            post.data.updatedDate && (
              <span>· updated on {dateFmt.format(post.data.updatedDate)}</span>
            )
          }
        </div>
      </header>
      <div class="prose">
        <Content />
      </div>
      <footer class="article-footer">
        <a href="/blog/" class="btn-outline">← All articles</a>
      </footer>
    </article>
  </main>
  <Footer />
</Layout>
