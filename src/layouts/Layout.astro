---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Zoléni Kokolo Zassi - Portfolio",
  description = "Portfolio of Zoléni Kokolo Zassi — Computer Science student at ENSEA, passionate about Python, data science, Linux infrastructure, and web development."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Bannière dédiée 1200×630 pour le partage social (généré via scripts/generate-og.mjs).
const ogImage = new URL('/assets/img/og-image.png', Astro.site);
// Photo réelle pour le schema.org Person (Google préfère un portrait, pas la bannière).
const personImage = new URL('/assets/img/photo_profile.jpg', Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Zoléni Kokolo Zassi",
  url: Astro.site?.toString(),
  image: personImage.toString(),
  jobTitle: "Python Developer & Junior Full Stack Developer",
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "ENSEA Cergy",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Chauconin-Neufmontiers",
    addressCountry: "FR",
  },
  sameAs: [
    "https://github.com/Sikoso774",
    "https://www.linkedin.com/in/zoléni-kokolo-zassi-280a282ba",
  ],
  knowsAbout: [
    "Python",
    "Data Science",
    "Linux",
    "Docker",
    "LXC",
    "Web Development",
    "Automation",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta name="author" content="Zoléni Kokolo Zassi" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Zoléni Kokolo Zassi — Python Developer, Data Science, Linux Infrastructure" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <ClientRouter />
  </head>
  <body>
    <div id="scroll-progress"></div>
    <slot />
    <button id="back-to-top" aria-label="Back to top">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
