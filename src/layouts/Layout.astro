---
import "@fontsource-variable/inter";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article" | "profile";
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  // Entités schema.org supplémentaires (ProfilePage, BlogPosting…) ajoutées au @graph.
  schema?: Record<string, unknown>[];
}

const {
  title = "Zoléni Kokolo Zassi — Python, Data & Linux Infrastructure",
  description = "Zoléni Kokolo Zassi is a Python developer and Bachelor Human IT student at ENSEA Cergy, focused on data science and Linux infrastructure. Portfolio, projects and blog.",
  ogType = "website",
  noindex = false,
  publishedTime,
  modifiedTime,
  schema = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Bannière dédiée 1200×630 pour le partage social (généré via scripts/generate-og.mjs).
const ogImage = new URL("/assets/img/og-image.png", Astro.site);
// Photo réelle pour le schema.org Person (Google préfère un portrait, pas la bannière).
const personImage = new URL("/assets/img/photo_profile.jpg", Astro.site);

const siteURL = Astro.site?.toString() ?? "https://zolenikokolo.com/";
// Identifiants stables : les autres entités (BlogPosting, ProfilePage…) y renvoient.
const personId = `${siteURL}#person`;
const websiteId = `${siteURL}#website`;

const personSchema = {
  "@type": "Person",
  "@id": personId,
  name: "Zoléni Kokolo Zassi",
  alternateName: ["Zoléni KOKOLO ZASSI", "Zoleni Kokolo Zassi"],
  url: siteURL,
  image: personImage.toString(),
  jobTitle: "Python Developer & Junior Full Stack Developer",
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "ENSEA Cergy",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Chauconin-Neufmontiers",
    addressCountry: "FR",
  },
  sameAs: [
    "https://github.com/Sikoso774",
    "https://www.linkedin.com/in/zoléni-kokolo-zassi-280a282ba",
  ],
  knowsAbout: [
    "Python",
    "Data Science",
    "Linux",
    "Docker",
    "LXC",
    "Web Development",
    "Automation",
  ],
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": websiteId,
  url: siteURL,
  name: "Zoléni Kokolo Zassi",
  inLanguage: "en",
  publisher: { "@id": personId },
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [personSchema, websiteSchema, ...schema],
};
---

<!doctype html>
<!--
  © 2026 Zoléni Kokolo Zassi — All Rights Reserved.
  Design, content and source code are the exclusive property of Zoléni Kokolo Zassi.
  This site is shared for portfolio purposes only. Copying or reusing any part
  without prior written authorization is strictly prohibited.
  Contact: https://zolenikokolo.com/contact
-->
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta name="author" content="Zoléni Kokolo Zassi" />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow"}
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Zoléni Kokolo Zassi — Blog"
      href="/rss.xml"
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Zoléni Kokolo Zassi" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Zoléni Kokolo Zassi — Python Developer, Data Science, Linux Infrastructure"
    />
    <meta property="og:locale" content="en_US" />
    {
      ogType === "article" && (
        <>
          {publishedTime && (
            <meta
              property="article:published_time"
              content={publishedTime.toISOString()}
            />
          )}
          {modifiedTime && (
            <meta
              property="article:modified_time"
              content={modifiedTime.toISOString()}
            />
          )}
          <meta property="article:author" content={siteURL} />
        </>
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <ClientRouter />
  </head>
  <body>
    <div id="scroll-progress"></div>
    <slot />
    <button id="back-to-top" aria-label="Back to top">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>
    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
