---
import Icon from "./Icon.astro";
---

<style>
  .footer {
    background: rgba(0, 0, 0, 0.5);
    border-top: 1px solid rgba(var(--clr-accent-rgb), 0.2);
    padding: 64px 0 48px;
  }

  /* Logo — dupliqué depuis Header.astro (scoping Astro oblige) */
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--clr-text);
    flex-shrink: 0;
  }

  .logo-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--grad-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 18px;
    flex-shrink: 0;
  }

  .logo-text {
    font-weight: 600;
    font-size: 18px;
    white-space: nowrap;
  }

  .footer-cta {
    text-align: center;
    padding-bottom: 56px;
    border-bottom: 1px solid rgba(var(--clr-accent-rgb), 0.15);
    margin-bottom: 40px;
  }

  .footer-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(var(--clr-accent-rgb), 0.1);
    border: 1px solid rgba(var(--clr-accent-rgb), 0.3);
    border-radius: 24px;
    color: var(--clr-accent);
    font-size: 13px;
    font-weight: 500;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--clr-accent);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.7);
    }
  }

  .footer-location {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--clr-text-dim);
    font-size: 13px;
  }

  .footer-cta h2 {
    font-size: 48px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 32px;
  }

  .footer-cta-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .footer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(var(--clr-accent-rgb), 0.15);
    margin-bottom: 32px;
  }

  .footer-nav {
    display: flex;
    gap: 24px;
  }

  .footer-nav a {
    color: var(--clr-text-dim);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .footer-nav a:hover {
    color: var(--clr-accent);
  }

  .social-icons {
    display: flex;
    gap: 12px;
  }

  .social-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(var(--clr-accent-rgb), 0.3);
    color: var(--clr-text-muted);
    text-decoration: none;
    transition: var(--transition);
  }

  .social-icon-btn:hover {
    border-color: var(--clr-accent);
    color: var(--clr-accent);
    background: rgba(var(--clr-accent-rgb), 0.1);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-bottom p {
    color: var(--clr-text-dim);
    font-size: 14px;
  }

  .built-with {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @keyframes heartbeat {
    0%,
    100% {
      transform: scale(1);
    }
    15% {
      transform: scale(1.3);
    }
    30% {
      transform: scale(1);
    }
    45% {
      transform: scale(1.3);
    }
    80% {
      transform: scale(1);
    }
  }

  .heart-icon {
    display: inline-block;
    vertical-align: middle;
    margin: 0 4px;
    animation: heartbeat 1.5s infinite;
  }

  @media (max-width: 768px) {
    .footer-cta h2 {
      font-size: 32px;
    }

    .footer-bar {
      flex-direction: column;
      text-align: center;
      gap: 20px;
    }

    .footer-nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 16px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
  }

  @media (prefers-color-scheme: light) {
    .footer {
      background: rgba(0, 0, 0, 0.04);
    }

    .logo-circle {
      color: #ffffff;
    }
  }
</style>

<footer id="contact" class="footer">
  <div class="container">
    <!-- CTA -->
    <div class="footer-cta">
      <div class="footer-meta">
        <span class="status-badge">
          <span class="status-dot"></span>
          Available for opportunities
        </span>
        <span class="footer-location">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          Chauconin-Neufmontiers, France
        </span>
      </div>
      <h2>Let's build something<br />together.</h2>
      <div class="footer-cta-actions">
        <a href="/contact" class="btn-primary">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
            ></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          Contact me
        </a>
        <a
          href="/assets/docs/CV_Zoleni_KOKOLO_ZASSI.pdf"
          download
          class="btn-outline"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Download CV
        </a>
      </div>
    </div>

    <!-- Bar -->
    <div class="footer-bar">
      <a href="/" class="logo">
        <div class="logo-circle">ZK</div>
        <span class="logo-text">Zoléni Kokolo</span>
      </a>
      <nav class="footer-nav">
        <a href="/about">About</a>
        <a href="/skills">Skills</a>
        <a href="/experience">Experience</a>
        <a href="/projects">Projects</a>
        <a href="/blog">Blog</a>
        <a href="/contact">Contact</a>
      </nav>
      <div class="social-icons">
        <a
          href="https://github.com/Sikoso774"
          target="_blank"
          rel="noopener noreferrer"
          class="social-icon-btn"
          aria-label="GitHub"
        >
          <Icon name="github" size={20} />
        </a>
        <a
          href="https://www.linkedin.com/in/zoléni-kokolo-zassi-280a282ba"
          target="_blank"
          rel="noopener noreferrer"
          class="social-icon-btn"
          aria-label="LinkedIn"
        >
          <Icon name="linkedin" size={20} />
        </a>
      </div>
    </div>

    <!-- Bottom -->
    <div class="footer-bottom">
      <p>
        © 2026 Zoléni Kokolo Zassi — All rights reserved. Design & content
        protected.
      </p>
      <p class="built-with">
        Built with
        <svg
          class="heart-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="#10b981"
          stroke="none"
        >
          <path
            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
          ></path>
        </svg>
        by Zoléni Kokolo Zassi
      </p>
    </div>
  </div>
</footer>
