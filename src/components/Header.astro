---
import Icon from "./Icon.astro";

// Liens indépendants de la page : toujours absolus vers la home + ancre.
// Indispensable car le header est `transition:persist` (non re-rendu d'une
// page à l'autre) — un lien relatif resterait collé à la page d'origine.
// Sur la home, `/#about` se comporte comme une ancre interne (scroll smooth) ;
// depuis /blog, il navigue vers la home puis défile jusqu'à la section.
const sectionHref = (id: string) => `/#${id}`;
const homeHref = "/#hero";
---

<style>
  #header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    transition: var(--transition);
  }

  #header.scrolled {
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
  }

  #header.menu-open {
    background: #030712;
    backdrop-filter: none;
    box-shadow: none;
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    position: relative;
    z-index: 2;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--clr-text);
    flex-shrink: 0;
  }

  .logo-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--grad-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 18px;
    flex-shrink: 0;
  }

  .logo-text {
    font-weight: 600;
    font-size: 18px;
    white-space: nowrap;
  }

  .desktop-nav {
    display: flex;
    gap: 32px;
  }

  .desktop-nav a {
    color: var(--clr-text-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .desktop-nav a:hover {
    color: var(--clr-accent);
  }

  .header-buttons {
    display: flex;
    gap: 16px;
  }

  .mobile-menu {
    display: none;
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    flex-shrink: 0;
    z-index: 100;
  }

  .mobile-menu-btn span {
    width: 24px;
    height: 2px;
    background: var(--clr-text);
    transition: var(--transition);
    flex-shrink: 0;
  }

  .mobile-menu-btn.active span:nth-child(1) {
    transform: rotate(45deg) translate(8px, 8px);
  }

  .mobile-menu-btn.active span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-btn.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  .nav-num {
    font-size: 11px;
    font-weight: 600;
    color: var(--clr-accent);
    letter-spacing: 0.1em;
    flex-shrink: 0;
    align-self: flex-end;
    padding-bottom: 5px;
  }

  /* Tablette / desktop étroit : logo réduit, nav resserrée, GitHub masqué */
  @media (min-width: 769px) and (max-width: 1024px) {
    .logo-text {
      display: none;
    }

    .desktop-nav {
      gap: 16px;
    }

    .desktop-nav a {
      font-size: 13px;
    }

    .header-buttons .btn-ghost {
      display: none;
    }

    .header-buttons a {
      white-space: nowrap;
    }
  }

  @media (max-width: 768px) {
    .desktop-nav,
    .header-buttons {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }

    /* Full-screen overlay */
    .mobile-menu {
      display: flex;
      position: fixed;
      inset: 0;
      z-index: 1;
      background: #030712;
      flex-direction: column;
      justify-content: center;
      padding: 80px 40px 48px;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    /* Grid pattern */
    .mobile-menu::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(var(--clr-accent-rgb), 0.05) 1px, transparent 1px),
        linear-gradient(
          90deg,
          rgba(var(--clr-accent-rgb), 0.05) 1px,
          transparent 1px
        );
      background-size: 48px 48px;
      pointer-events: none;
    }

    /* Ambient glow bottom-right */
    .mobile-menu::after {
      content: "";
      position: absolute;
      bottom: -120px;
      right: -120px;
      width: 520px;
      height: 520px;
      background: radial-gradient(
        circle,
        rgba(var(--clr-accent-rgb), 0.12) 0%,
        transparent 65%
      );
      pointer-events: none;
    }

    .mobile-menu.active {
      opacity: 1;
      pointer-events: auto;
    }

    .mobile-menu nav {
      display: flex;
      flex-direction: column;
      position: relative;
      z-index: 1;
    }

    /* Exit: simultaneous, fast */
    .mobile-menu nav a {
      display: flex;
      align-items: baseline;
      gap: 14px;
      color: var(--clr-text);
      text-decoration: none;
      font-size: 38px;
      font-weight: 700;
      line-height: 1;
      padding: 14px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      transform: translateX(-28px);
      opacity: 0;
      transition:
        transform 0.2s ease,
        opacity 0.15s ease,
        color 0.2s ease;
    }

    .mobile-menu nav a:first-child {
      border-top: 1px solid rgba(255, 255, 255, 0.07);
    }

    .mobile-menu nav a:hover {
      color: var(--clr-accent);
    }

    /* Enter: staggered */
    .mobile-menu.active nav a {
      transform: translateX(0);
      opacity: 1;
      transition:
        transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)
          calc(var(--i, 0) * 60ms + 0.05s),
        opacity 0.4s ease calc(var(--i, 0) * 60ms + 0.05s),
        color 0.2s ease;
    }

    .mobile-menu-actions {
      display: flex;
      gap: 12px;
      margin-top: 32px;
      position: relative;
      z-index: 1;
      transform: translateY(14px);
      opacity: 0;
      transition:
        transform 0.2s ease,
        opacity 0.15s ease;
    }

    .mobile-menu.active .mobile-menu-actions {
      transform: translateY(0);
      opacity: 1;
      transition:
        transform 0.45s ease 0.42s,
        opacity 0.4s ease 0.42s;
    }

    .mobile-menu-actions a {
      flex: 1;
      justify-content: center;
    }

    /* Small height (landscape phone) */
    @media (max-height: 600px) {
      .mobile-menu nav a {
        font-size: 26px;
        padding: 9px 0;
      }
      .mobile-menu {
        padding-top: 64px;
      }
    }
  }

  @media (prefers-color-scheme: light) {
    #header.scrolled {
      background: rgba(255, 255, 255, 0.95);
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.08);
    }

    #header.menu-open {
      background: #f8fafc;
      box-shadow: none;
    }

    .logo-circle {
      color: #ffffff;
    }

    .mobile-menu {
      background: #f8fafc;
    }

    .mobile-menu nav a {
      color: #111827;
      border-bottom-color: rgba(0, 0, 0, 0.08);
    }

    .mobile-menu nav a:first-child {
      border-top-color: rgba(0, 0, 0, 0.08);
    }
  }
</style>

<header id="header" transition:persist>
  <div class="container">
    <div class="header-content">
      <a href={homeHref} class="logo">
        <div class="logo-circle">ZK</div>
        <span class="logo-text">Zoléni Kokolo</span>
      </a>

      <nav class="desktop-nav">
        <a href={sectionHref("about")}>About</a>
        <a href={sectionHref("skills")}>Skills</a>
        <a href={sectionHref("experience")}>Experience</a>
        <a href={sectionHref("projects")}>Projects</a>
        <a href="/blog">Blog</a>
        <a href={sectionHref("contact")}>Contact</a>
      </nav>

      <div class="header-buttons">
        <a
          href="https://github.com/Sikoso774"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          <Icon name="github-outline" size={16} />
          GitHub
        </a>
        <a
          href="/assets/docs/CV_Zoleni_KOKOLO_ZASSI.pdf"
          download
          class="btn-primary"
        >
          <Icon name="download" size={16} />
          Download CV
        </a>
      </div>

      <button
        class="mobile-menu-btn"
        id="mobileMenuBtn"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
      <nav>
        <a href={sectionHref("about")} style="--i:0"
          ><span class="nav-num">01</span>About</a
        >
        <a href={sectionHref("skills")} style="--i:1"
          ><span class="nav-num">02</span>Skills</a
        >
        <a href={sectionHref("experience")} style="--i:2"
          ><span class="nav-num">03</span>Experience</a
        >
        <a href={sectionHref("projects")} style="--i:3"
          ><span class="nav-num">04</span>Projects</a
        >
        <a href="/blog" style="--i:4"><span class="nav-num">05</span>Blog</a>
        <a href={sectionHref("contact")} style="--i:5"
          ><span class="nav-num">06</span>Contact</a
        >
      </nav>
      <div class="mobile-menu-actions">
        <a
          href="https://github.com/Sikoso774"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          <Icon name="github-outline" size={16} />
          GitHub
        </a>
        <a
          href="/assets/docs/CV_Zoleni_KOKOLO_ZASSI.pdf"
          download
          class="btn-outline"
        >
          <Icon name="download" size={16} />
          Download CV
        </a>
      </div>
    </div>
  </div>
</header>
