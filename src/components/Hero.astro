<section id="hero" class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-image">
        <div class="profile-halo"></div>
        <div class="profile-circle">
          <img
            src="/assets/img/photo_profile.jpg"
            alt="Zoléni Kokolo Zassi"
            loading="lazy"
          />
        </div>
      </div>
      <div class="hero-content">
        <div class="badge">Welcome to my portfolio</div>
        <h1>Hi there!</h1>
        <p>
          I'm <span class="highlight">Zoléni Kokolo Zassi</span> — a Python
          Developer & Junior Full Stack Developer passionate about
          automation, infrastructure migration (Docker/LXC), and building
          concrete end-to-end software solutions. I'm driven by curiosity,
          creativity, and the desire to solve real-world problems.
        </p>
        <div class="hero-buttons">
          <a href="#projects" class="btn-primary">See My Work</a>
          <a href="#contact" class="btn-outline">Get in Touch</a>
        </div>
      </div>
    </div>
  </div>
</section>
