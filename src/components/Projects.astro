---
import Icon from "./Icon.astro";
---

<style>
  .projects {
    background: rgba(0, 0, 0, 0.3);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .project-card {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .project-card h3 {
    font-size: 24px;
    font-weight: 600;
    color: var(--clr-text);
    transition: color 0.2s ease;
  }

  .project-card:hover h3 {
    color: var(--clr-accent);
  }

  .project-card > p {
    color: var(--clr-text-muted);
    line-height: 1.6;
    flex-grow: 1;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-color-scheme: light) {
    .projects {
      background: rgba(0, 0, 0, 0.03);
    }
  }
</style>

<section id="projects" class="projects">
  <div class="container">
    <div class="section-header">
      <h2>Featured Projects</h2>
      <div class="underline"></div>
      <p class="section-description">
        A selection of projects showcasing my skills in software development,
        data science, and digital innovation.
      </p>
    </div>
    <div class="projects-grid">
      <div class="card project-card">
        <h3>Nebulux — Obsidian Theme</h3>
        <p>
          Custom dark theme for Obsidian featuring a deep nebula-inspired color
          palette. Published on the official Obsidian community marketplace with
          300+ downloads.
        </p>
        <div class="tags">
          <span>CSS</span>
          <span>Obsidian</span>
          <span>UI Design</span>
          <span>Open Source</span>
        </div>
        <div class="project-links">
          <a href="obsidian://show-theme?name=Nebulux" class="btn-primary">
            <!-- prettier-ignore -->
