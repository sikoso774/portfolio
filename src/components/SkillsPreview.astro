---
---

<style>
  .skills-preview {
    background: rgba(0, 0, 0, 0.3);
  }

  .skills-categories-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }

  .category-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 24px;
  }

  .category-chip svg {
    color: var(--clr-accent);
    flex-shrink: 0;
  }

  .category-chip span {
    font-size: 14px;
    font-weight: 600;
    color: var(--clr-text);
    white-space: nowrap;
  }

  .skills-footer {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  .see-more-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--clr-text-dim);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    padding: 10px 20px;
    border: 1px solid rgba(var(--clr-accent-rgb), 0.2);
    border-radius: var(--radius-sm);
    transition: var(--transition-fast);
  }

  .see-more-link:hover {
    color: var(--clr-accent);
    border-color: rgba(var(--clr-accent-rgb), 0.5);
    background: rgba(var(--clr-accent-rgb), 0.05);
  }

  @media (prefers-color-scheme: light) {
    .skills-preview {
      background: rgba(0, 0, 0, 0.03);
    }
  }
</style>

<section id="skills" class="skills-preview">
  <div class="container">
    <div class="section-header">
      <h2>Skills & Expertise</h2>
      <div class="underline"></div>
    </div>
    <div class="skills-categories-row">
      <div class="card category-chip">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        <span>Code</span>
      </div>
      <div class="card category-chip">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <rect x="3" y="3" width="18" height="18" rx="2"></rect>
          <line x1="3" y1="9" x2="21" y2="9"></line>
          <line x1="9" y1="21" x2="9" y2="9"></line>
        </svg>
        <span>Web</span>
      </div>
      <div class="card category-chip">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
          <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
          <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
        </svg>
        <span>Data Science</span>
      </div>
      <div class="card category-chip">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
          <rect x="9" y="9" width="6" height="6"></rect>
          <line x1="9" y1="1" x2="9" y2="4"></line>
          <line x1="15" y1="1" x2="15" y2="4"></line>
          <line x1="9" y1="20" x2="9" y2="23"></line>
          <line x1="15" y1="20" x2="15" y2="23"></line>
          <line x1="20" y1="9" x2="23" y2="9"></line>
          <line x1="20" y1="14" x2="23" y2="14"></line>
          <line x1="1" y1="9" x2="4" y2="9"></line>
          <line x1="1" y1="14" x2="4" y2="14"></line>
        </svg>
        <span>Back End / DevOps</span>
      </div>
      <div class="card category-chip">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="4 17 10 11 4 5"></polyline>
          <line x1="12" y1="19" x2="20" y2="19"></line>
        </svg>
        <span>OS & Shell</span>
      </div>
      <div class="card category-chip">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
          ></path>
        </svg>
        <span>Dev Tools</span>
      </div>
    </div>
    <div class="skills-footer">
      <a href="/skills" class="see-more-link">
        See all skills & proficiency levels
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>
