<style>
  .experience-preview-card {
    padding: 24px;
    max-width: 560px;
    margin: 0 auto;
  }

  .experience-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(var(--clr-accent-rgb), 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-wrapper svg {
    color: var(--clr-accent);
  }

  .year {
    color: var(--clr-text-dim);
    font-size: 14px;
  }

  .experience-preview-card h3 {
    font-size: 20px;
    font-weight: 600;
    color: var(--clr-text);
    margin-bottom: 8px;
  }

  .company {
    color: var(--clr-accent);
    font-weight: 500;
    margin-bottom: 12px;
  }

  .description {
    color: var(--clr-text-muted);
    line-height: 1.6;
  }

  .experience-footer {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  .see-more-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--clr-text-dim);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    padding: 10px 20px;
    border: 1px solid rgba(var(--clr-accent-rgb), 0.2);
    border-radius: var(--radius-sm);
    transition: var(--transition-fast);
  }

  .see-more-link:hover {
    color: var(--clr-accent);
    border-color: rgba(var(--clr-accent-rgb), 0.5);
    background: rgba(var(--clr-accent-rgb), 0.05);
  }
</style>

<section id="experience" class="experience">
  <div class="container">
    <div class="section-header">
      <h2>Experience</h2>
      <div class="underline"></div>
    </div>
    <div class="card experience-preview-card">
      <div class="experience-header">
        <div class="icon-wrapper">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
        </div>
        <span class="year">Apr 2026 – Present</span>
      </div>
      <h3>Python Developer</h3>
      <p class="company">NOXIA Security • Bailly Romainvilliers</p>
      <p class="description">
        Development of in-house tools for the company.
      </p>
    </div>
    <div class="experience-footer">
      <a href="/experience" class="see-more-link">
        View full timeline & education details
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>
